---
import { getCollection } from "astro:content";
import CardSection from "../../components/CardSection.astro";
import SimpleLayout from "../../components/SimpleLayout.astro";
import Tile from "../../components/Tile.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const experience = (await getCollection("experience")).sort(
	(a, b) => a.data.order - b.data.order,
);
const link =
	"text-international-orange-700 hover:underline dark:text-international-orange-500";
---

<BaseLayout
	title="Work"
	description="Jp Valery's career in customer success and growth: Resend, Customer.io, Local Logic, LANDR, and Gameloft, plus recommendations and how I like to work."
>
	<SimpleLayout
		title="Work"
		intro="Customer Success Engineer at Resend. I've spent over a decade helping people do more with email, as a sender and as a vendor: leading customer success teams, building growth functions, and marketing games."
	>
		<div class="grid gap-6 lg:gap-8">
			<CardSection section="work" variant="row" />
			<Tile label="Experience" aside="2014—now" heading>
				<ol>
					{
						experience.map(({ data }) => (
							<li class="grid gap-1 border-stone-300 border-t border-dashed py-6 first:border-0 first:pt-0 md:grid-cols-[8rem_1fr] md:gap-6 dark:border-ink-700">
								<span class="text-international-orange-700 text-sm tabular-nums dark:text-international-orange-500">
									{data.years}
								</span>
								<div>
									<h3 class="font-departure text-base text-zinc-900 dark:text-phosphor-100">
										{data.url ? (
											<a href={data.url} rel="noopener" class="hover:underline">
												{data.company}
											</a>
										) : (
											data.company
										)}
									</h3>
									<p class="text-sm text-stone-500 dark:text-phosphor-500">{data.about}</p>
									<ol class="mt-4 grid gap-5">
										{data.roles.map((role) => (
											<li>
												<p class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm">
													<span class="font-medium text-zinc-900 dark:text-phosphor-100">{role.title}</span>
													<span class="text-stone-500 text-xs uppercase tabular-nums tracking-wider dark:text-phosphor-500">
														{role.dates}
													</span>
												</p>
												<ul class="mt-2 grid max-w-3xl gap-1.5 text-sm text-zinc-700 dark:text-phosphor-100">
													{role.highlights.map((highlight) => (
														<li class="relative pl-4 before:absolute before:left-0 before:text-international-orange-500 before:content-['›']">
															{highlight}
														</li>
													))}
												</ul>
											</li>
										))}
									</ol>
								</div>
							</li>
						))
					}
				</ol>
				<a href="https://resume.jpvalery.me" class:list={[link, 'mt-4 inline-block text-xs uppercase tracking-wider']}>
					Full resume ↗
				</a>
			</Tile>
			<CardSection section="advisory" />
		</div>
	</SimpleLayout>
</BaseLayout>
