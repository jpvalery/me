---
import { getCollection, render } from "astro:content";
import Container from "../../components/Container.astro";
import Prose from "../../components/Prose.astro";
import SimpleLayout from "../../components/SimpleLayout.astro";
import Tile from "../../components/Tile.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

// One page per src/content/pages/work/*.md
export async function getStaticPaths() {
	const pages = await getCollection("pages", (p) => p.id.startsWith("work/"));
	return pages.map((entry) => ({
		params: { slug: entry.id.slice("work/".length) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { title, description, intro, wide } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={description ?? intro}>
	{
		wide ? (
			<Container class="pt-12 pb-8 sm:pt-16">
				<p class="mb-4 text-[0.75rem] text-international-orange-700 uppercase tracking-[0.14em] dark:text-international-orange-500">
					{Astro.url.pathname.replace(/\/$/, '')}
				</p>
				<h1 class="mb-10 text-balance font-departure text-4xl text-zinc-900 sm:text-6xl dark:text-phosphor-100">
					{title}
				</h1>
				<Tile label="Details">
					<Prose class="max-w-none">
						<Content />
					</Prose>
				</Tile>
			</Container>
		) : (
			<SimpleLayout title={title} intro={intro}>
				<Tile label="Details">
					<Prose class="max-w-none">
						<Content />
					</Prose>
				</Tile>
			</SimpleLayout>
		)
	}
</BaseLayout>
