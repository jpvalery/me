---
import { getCollection } from "astro:content";
import CtaLink from "../../components/CtaLink.astro";
import SimpleLayout from "../../components/SimpleLayout.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { tile } from "../../lib/ui";

const entries = (await getCollection("recommendations")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
	title="Recommendations"
	description="What colleagues and clients say about working with Jp Valery, in their own words."
>
	<SimpleLayout
		title="Recommendations"
		intro="Hear what people I worked with have to say"
	>
		<div class="grid grid-cols-1 gap-6 lg:gap-8">
			{
				entries.map((r) => (
					<figure
						class:list={[
							tile, 'max-h-min',
						]}
					>
						<blockquote class="p-6 text-base text-zinc-900 sm:p-8 dark:text-phosphor-100">
							<p class="whitespace-pre-line">“{r.data.quote}”</p>
						</blockquote>
						<figcaption class="flex items-center gap-4 border-stone-300 border-t px-6 py-4 sm:px-8 dark:border-ink-700">
							<img
								alt=""
								src={r.data.avatar}
								width="100"
								height="100"
								loading="lazy"
								class="size-10 flex-none bg-stone-200 object-cover dark:bg-ink-950"
							/>
							<div class="flex-auto text-sm text-international-orange-700 uppercase tracking-wider dark:text-international-orange-500">
								{r.data.author}
							</div>
						</figcaption>
					</figure>
				))
			}
		</div>
		<div class="mt-12">
			<CtaLink href="https://raccoonv.com">Work with Raccoon Ventures</CtaLink>
		</div>
	</SimpleLayout>
</BaseLayout>
