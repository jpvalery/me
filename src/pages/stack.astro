---
import { getCollection } from "astro:content";
import Section from "../components/Section.astro";
import SimpleLayout from "../components/SimpleLayout.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const sections = (await getCollection("stack")).sort(
	(a, b) => a.data.order - b.data.order,
);
const intro =
	"I get asked a lot about the things I use to build software, stay productive, or buy to fool myself into thinking I’m being productive when I’m really just procrastinating. Here’s a big list of all of my favorite stuff.";
---

<BaseLayout
	title="My Stack"
	description="The software, gadgets and tools Jp Valery uses to build, stay productive and get things done, with notes on each."
>
	<SimpleLayout
		title="Software I use, gadgets I love, and other things I recommend."
		intro={intro}
	>
		<div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
			{
				sections.map(({ data: { name, items } }) => (
					<Section title={name}>
						<ul>
							{items.map((item) => (
								<li class="border-stone-300 border-t border-dashed py-4 first:border-0 first:pt-0 last:pb-0 dark:border-ink-700">
									<h3 class="font-departure text-base text-zinc-900 dark:text-phosphor-100">
										{item.title}
									</h3>
									{item.description && (
										<p class="mt-1 text-sm text-stone-600 dark:text-phosphor-500">
											{item.description}
										</p>
									)}
								</li>
							))}
						</ul>
					</Section>
				))
			}
		</div>
	</SimpleLayout>
</BaseLayout>
