---
import Button from "../../components/Button.astro";
import ContactAside from "../../components/ContactAside.astro";
import SimpleLayout from "../../components/SimpleLayout.astro";
import Tile from "../../components/Tile.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Get in touch" description="Get in touch with Jp Valery about work, photography, or just to say hi.">
	<SimpleLayout title="Get in touch">
		<div class="grid gap-6 lg:grid-cols-12 lg:gap-8">
	<Tile label="Before you write" class="lg:col-span-8">
		<div class="prose max-w-none dark:prose-invert">
			<p>
				I'm gonna be real. I can't pursue every opportunity that comes my way
				and have to be extremely picky.
			</p>
			<p>
				It's hard but that's the only way I can keep a sane bandwidth <em>and</em
				> keep shipping quality work.
			</p>
			<p>
				The more information you can give me about why we should work / play /
				get together — and why it will be fun / exciting / challenging /
				rewarding / life-changing — the more likely I’ll be to get on board.
			</p>
			<p>
				Share as much detail with as much honesty as possible and let me know
				why you feel we would work well together.
			</p>
			<p>
				In return, I <u>promise</u> I'll get back to you in a timely manner and
				offer some alternatives if I can't help you.
			</p>
			<p>Sounds good?</p>
		</div>
			<div class="mt-10">
				<Button href="/contact/generic">Contact me</Button>
			</div>
		</Tile>
	<ContactAside class="lg:col-span-4" />
	</div>
	</SimpleLayout>
</BaseLayout>
