---
import { getCollection } from "astro:content";
import NowEntry from "../../components/NowEntry.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { nowDescription, nowJsonLd, nowStamp } from "../../lib/seo";

export async function getStaticPaths() {
	const entries = await getCollection("now");
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const origin = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
// The latest entry is also served at /now, which is its canonical home
const [latest] = (await getCollection("now")).sort((a, b) =>
	b.data.date.localeCompare(a.data.date),
);
const isLatest = latest?.id === entry.id;
const canonical = isLatest ? "/now" : undefined;
---

<BaseLayout
	title={entry.data.title}
	description={nowDescription(entry.data.date)}
	type="article"
	publishedTime={nowStamp(entry.data.date)}
	canonical={canonical}
	jsonLd={nowJsonLd(entry, origin, `${origin}${canonical ?? Astro.url.pathname}`)}
>
	<NowEntry entry={entry} />
</BaseLayout>
