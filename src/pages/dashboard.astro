---
import MetricCard from "../components/MetricCard.astro";
import SimpleLayout from "../components/SimpleLayout.astro";
import Tile from "../components/Tile.astro";
import flying from "../content/flying.json";
import imdb from "../content/imdb.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { dashboardStats } from "../lib/dashboard-data";

const { unsplash, betaseries } = await dashboardStats;
const fmt = (n: number | undefined) => n?.toLocaleString("en-US") ?? "—";
/** Name the source when a tile mixes several: "Betaseries last updated: …". */
const note = (updatedAt?: string, source?: string) => {
	if (!updatedAt)
		return `${source ? `${source} statistics` : "Statistics"} temporarily unavailable`;
	const date = new Date(updatedAt);
	if (Number.isNaN(date.getTime()))
		throw new Error(`Invalid dashboard date "${updatedAt}": use YYYY-MM-DD`);
	const day = date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
		timeZone: "UTC",
	});
	return source ? `${source} last updated: ${day}` : `Last updated: ${day}`;
};

const sections = [
	{
		title: "Foreflight",
		note: note(flying.updated),
		items: flying.stats.map((s) => ({ ...s, href: s.link })),
	},
	{
		title: "Unsplash",
		note: note(unsplash?.updatedAt),
		items: [
			{
				title: "Unsplash — Downloads",
				metric: fmt(unsplash?.downloads),
				href: "https://unsplash.com/@jpvalery",
			},
			{
				title: "Unsplash — Views",
				metric: fmt(unsplash?.views),
				href: "https://unsplash.com/@jpvalery",
			},
		],
	},
	{
		title: "Shows & Movies",
		note: [
			note(betaseries?.updatedAt, "Betaseries"),
			note(imdb.updated, "IMDB"),
		].join(" · "),
		items: [
			{
				title: "Betaseries — Episodes seen",
				metric: fmt(betaseries?.episodes),
				href: "https://www.betaseries.com/membre/jpvalery",
			},
			{
				title: "IMDB — Show/Movies seen",
				metric: imdb.seen,
				href: imdb.link,
			},
		],
	},
];
---

<BaseLayout
	title="Dashboard"
	description="Personal metrics from Jp Valery: flight hours and landings, Unsplash views and downloads, and shows watched, with the latest available statistics and refresh dates."
>
	<SimpleLayout
		title="Dashboard"
		intro="Some personal metrics, mostly for the fun of connecting APIs."
	>
		<div class="grid gap-6 lg:gap-8">
			{
				sections.map((section) => (
					<Tile label={section.title} aside={section.note} heading>
						<ul class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-5">
							{section.items.map((item) => (
								<MetricCard {...item} />
							))}
						</ul>
					</Tile>
				))
			}
		</div>
	</SimpleLayout>
</BaseLayout>
