---
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.status = 404;
---

<BaseLayout title="Page not found" noindex>
	<Container class="flex h-full items-center pt-16 sm:pt-32">
		<div class="flex flex-col items-center">
			<p class="font-semibold text-base text-zinc-400 dark:text-zinc-500">404</p>
			<h1
				class="mt-4 font-bold font-departure text-4xl text-zinc-900 tracking-tight sm:text-5xl dark:text-zinc-100"
			>
				Page not found
			</h1>
			<p class="mt-4 text-base text-zinc-600 dark:text-zinc-400">
				Sorry, we couldn’t find the page you’re looking for.
			</p>
			<Button href="/" variant="secondary" class="mt-4">Go back home</Button>
		</div>
	</Container>
</BaseLayout>
