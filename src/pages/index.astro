---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import Photos from "../components/Photos.astro";
import RatingIcon from "../components/RatingIcon.astro";
import Tile from "../components/Tile.astro";
import flying from "../content/flying.json";
import portrait from "../images/portrait.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, socials as socialLinks } from "../lib/site";
import { socialIcons } from "../lib/socialIcons";
import { tile } from "../lib/ui";

const home = await getEntry("pages", "home");
if (!home) throw new Error("Missing src/content/pages/home.md");
const { Content } = await render(home);

const socials = socialLinks.map(
	({ url, label }) => [url, label, socialIcons[label]] as const,
);

const [latestNow] = (await getCollection("now")).sort((a, b) =>
	b.data.date.localeCompare(a.data.date),
);
const nowExcerpt = (latestNow?.body ?? "")
	.split(/\n{2,}/)[0]
	.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
	.replace(/[*_`]/g, "");
const projectCount = (await getCollection("cards")).filter(
	(c) => c.data.section === "projects",
).length;
const pilotStats = flying.stats.filter((s) =>
	["Flights", "Time", "Landings"].includes(s.title),
);

const go =
	"mt-auto text-xs text-international-orange-600 uppercase tracking-wider hover:underline dark:text-international-orange-500";
const h3 = "mb-2 font-departure text-lg";
const muted = "text-sm text-stone-600 dark:text-phosphor-500";
---

<BaseLayout title={home.data.title} description={home.data.description}>
	<div
		class="mx-auto grid max-w-7xl grid-cols-1 gap-6 px-4 py-8 sm:px-8 sm:py-12 lg:grid-cols-12 lg:gap-8"
	>
		<Tile label="About" aside={site.location} class="flex flex-col lg:col-span-7">
			<p
				class="font-departure text-5xl text-international-orange-600 italic sm:text-7xl dark:text-international-orange-500 dark:[text-shadow:0_0_14px_rgb(255_122_31/0.5)]"
			>
				Bonjour, hi!
			</p>
			<h1 class="mt-3 max-w-none text-balance font-departure text-lg sm:text-xl">
				I'm Jp and I wear more hats than a H1 can fit
			</h1>
			<div class="mt-auto flex flex-wrap items-center gap-x-8 gap-y-4 pt-10">
				<div class="flex items-center gap-5">
					{
						socials.map(([href, label, Icon]) => (
							<a
								href={href}
								class="size-6 text-zinc-900 transition hover:text-international-orange-600 dark:text-phosphor-100 dark:hover:text-international-orange-500"
							>
								<span class="sr-only">{label}</span>
								<Icon />
							</a>
						))
					}
				</div>
				<a
					href={`mailto:${site.email}`}
					class:list={[muted, 'transition hover:text-international-orange-600 dark:hover:text-international-orange-500']}
				>
					{site.email}
				</a>
			</div>
		</Tile>

		<section
			class:list={[tile, 'flex flex-col self-start lg:col-span-5']}
		>
			<div
				class="relative aspect-square w-full overflow-hidden bg-international-orange-500 dark:bg-[#1a0e05]"
			>
				<Image
					src={portrait}
					alt="Portrait of Jp Valery"
					sizes="(min-width: 1024px) 32rem, 100vw"
					class="absolute inset-0 size-full object-cover contrast-125 grayscale mix-blend-multiply dark:mix-blend-screen"
					loading="eager"
				/>
			</div>
			<p
				class="flex justify-between gap-3 border-stone-300 border-t px-5 py-3 text-[0.68rem] text-stone-500 uppercase tracking-[0.14em] dark:border-ink-700 dark:text-phosphor-500"
			>
				<span>Jp Valery</span><span>Pilot · Builder · Gardener</span>
			</p>
		</section>

		<Tile label="Bio" class="lg:col-span-7 lg:row-span-2">
			<div class="prose max-w-none dark:prose-invert prose-p:my-5 prose-p:first:mt-0 prose-p:last:mb-0">
				<Content />
			</div>
		</Tile>

		<Tile label="Work" aside="Resume · Company" class="flex flex-col lg:col-span-5">
			<h2 class={h3}>Work with me</h2>
			<p class:list={[muted, 'mb-6']}>My resume, what colleagues say, and how I like to work.</p>
			<a href="/work" class={go}>See my work →</a>
		</Tile>

		<Tile label="Pilot log" aside="Ratings" class="lg:col-span-5">
			<table class="w-full text-sm tabular-nums">
				<tbody>
					{
						flying.ratings.map((r) => (
							<tr class="border-stone-300 border-t border-dashed dark:border-ink-700">
								<td class="py-3">
									<RatingIcon
										name={r.icon}
										class:list={[
											'mr-3 -mt-0.5 inline-block size-4',
											r.next
												? 'text-stone-500 dark:text-phosphor-500'
												: 'text-international-orange-600 dark:text-international-orange-500',
										]}
									/>
									<span class={r.next ? 'text-stone-500 dark:text-phosphor-500' : ''}>
										{r.title}
									</span>
								</td>
								<td class="py-3 text-right text-stone-500 dark:text-phosphor-500">
									{r.next ? 'Next' : (r.when ?? '')}
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
			<dl class="mt-6 grid grid-cols-3 gap-4 border-stone-300 border-t pt-6 dark:border-ink-700">
				{
					pilotStats.map((s) => (
						<div>
							<dt class="text-[0.68rem] text-stone-500 uppercase tracking-[0.14em] dark:text-phosphor-500">
								{s.title}
							</dt>
							<dd class="font-departure text-2xl text-international-orange-600 dark:text-international-orange-500">
								{s.metric}
							</dd>
						</div>
					))
				}
			</dl>
		</Tile>

		<Tile label="Now" aside={latestNow?.data.date} class="flex flex-col lg:col-span-7">
			<h2 class={h3}>What I'm up to</h2>
			<p class:list={[muted, 'mb-6 line-clamp-5']}>{nowExcerpt}</p>
			<a href="/now" class={go}>Read now →</a>
		</Tile>

		<Tile label="Projects" aside={`${projectCount} listed`} class="flex flex-col lg:col-span-5">
			<h2 class={h3}>Things I made</h2>
			<p class:list={[muted, 'mb-6']}>Side projects, tools and the odd experiment.</p>
			<a href="/projects" class={go}>See projects →</a>
		</Tile>
	</div>
	<Photos />
</BaseLayout>
