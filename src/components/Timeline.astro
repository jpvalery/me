---
interface Props {
	items: { slug: string; date: string }[];
	/** Always vertical, for narrow columns */
	vertical?: boolean;
}
const { vertical = false } = Astro.props;
const fmt = (d: string) =>
	new Date(`${d}T13:00:00.000Z`).toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		timeZone: 'UTC',
	});
const items = [...Astro.props.items].sort((a, b) =>
	a.date.localeCompare(b.date),
);
const marker =
	'size-3 bg-international-orange-500 ring-4 ring-stone-100 transition-transform duration-200 ease-out group-hover:scale-125 dark:ring-ink-950';
const label =
	'border border-stone-300 bg-stone-50 px-2 py-1 transition-transform duration-200 ease-out group-hover:scale-110 dark:border-ink-700 dark:bg-ink-900';
---

<nav aria-label="Now archive" class="mx-auto w-full pt-4 pb-10">
	<!-- Desktop: horizontal -->
	<div class={vertical ? 'hidden' : 'hidden md:block'}>
		<div class="relative">
			<div class="absolute top-1/2 right-0 left-0 h-px -translate-y-1/2 bg-stone-400 dark:bg-ink-700"></div>
			<div class="relative flex items-center justify-between">
				{
					items.map((item) => (
						<div class="relative flex flex-col items-center">
							<a href={`/now/${item.slug}`} class="group relative z-10">
								<div class={marker} />
								<div class="absolute top-8 left-1/2 -translate-x-1/2 whitespace-nowrap">
									<div class={label}>
										<span class="font-medium text-[0.75rem] text-zinc-700 uppercase leading-[0.8rem] tracking-wider group-hover:text-international-orange-600 dark:text-phosphor-100">
											{fmt(item.date)}
										</span>
									</div>
								</div>
							</a>
						</div>
					))
				}
				<div class="relative flex flex-col items-center">
					<a href="/now" class="group relative z-10">
						<div class={marker} />
						<div class="absolute top-8 left-1/2 -translate-x-1/2 whitespace-nowrap">
							<div
								class="border border-international-orange-500 bg-stone-50 px-3 py-1 transition-transform duration-200 ease-out group-hover:scale-110 dark:bg-zinc-900"
							>
								<span class="text-xs text-zinc-700 uppercase tracking-wider group-hover:text-international-orange-600 dark:text-phosphor-100">
									Latest
								</span>
							</div>
						</div>
					</a>
				</div>
			</div>
		</div>
	</div>

	<!-- Mobile: vertical -->
	<div class={vertical ? '' : 'md:hidden'}>
		<div class="relative">
			<div class="absolute top-0 bottom-0 left-1.5 w-px bg-stone-400 dark:bg-ink-700"></div>
			<div class="space-y-6">
				{
					[...items.map((i) => [`/now/${i.slug}`, fmt(i.date)]), ['/now', 'Latest']].map(
						([href, text]) => (
							<div class="relative flex items-center">
								<a href={href} class="group relative z-10 flex items-center">
									<div class="size-3 bg-international-orange-500 ring-4 ring-stone-100 dark:ring-ink-950" />
									<div class="ml-6 border border-stone-300 bg-stone-50 px-4 py-2 transition group-hover:border-international-orange-500 dark:border-ink-700 dark:bg-ink-900">
										<span class="text-sm text-zinc-700 uppercase tracking-wider group-hover:text-international-orange-600 dark:text-phosphor-100">
											{text}
										</span>
									</div>
								</a>
							</div>
						),
					)
				}
			</div>
		</div>
	</div>
</nav>
