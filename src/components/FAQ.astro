---
import { getEntry, render } from 'astro:content';
import Prose from './Prose.astro';

// src/content/pages/faq.md: one "## Question" heading per question
const faq = await getEntry('pages', 'faq');
if (!faq) throw new Error('Missing src/content/pages/faq.md');
const { Content } = await render(faq);
---

<Prose
	class="max-w-2xl prose-h2:mt-10 prose-h2:mb-2 prose-h2:font-departure prose-h2:font-normal prose-h2:text-xl first:prose-h2:mt-0"
>
	<Content />
</Prose>
