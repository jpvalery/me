---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import type { ContactFormDef } from '../lib/contact';

interface Props {
	def: ContactFormDef;
}
const { def } = Astro.props;
const siteKey = PUBLIC_TURNSTILE_SITE_KEY;
const input =
	'block w-full rounded-sm border-gray-300 text-gray-900 shadow-xs focus:border-international-orange-400 focus:ring-international-orange-400';
---

<form
	id="contact-form"
	data-type={def.type}
	autocomplete="off"
	class="mx-auto w-full"
>
	{
		def.fields.map((f) => (
			<div class="grid grid-flow-row gap-3 p-4">
				<label
					for={f.name}
					class="w-full font-medium text-gray-500 dark:text-gray-200"
				>
					{f.label}
				</label>
				{f.options ? (
					<select
						id={f.name}
						name={f.name}
						required={f.required}
						class={`${input} mt-1 py-2 pr-10 pl-3 text-base`}
					>
						<option value="" disabled selected>
							Pick one
						</option>
						{f.options.map((o) => (
							<option value={o.value}>{o.label}</option>
						))}
					</select>
				) : f.name === 'message' ? (
					<textarea
						id={f.name}
						name={f.name}
						rows="3"
						required={f.required}
						maxlength={280}
						class={input}
					/>
				) : (
					<input
						id={f.name}
						name={f.name}
						type={f.name === 'email' ? 'email' : 'text'}
						placeholder={f.placeholder}
						required={f.required}
						maxlength={80}
						class={input}
					/>
				)}
			</div>
		))
	}

	<div class="grid grid-flow-col items-center justify-start gap-3 p-4">
		<label
			for="checked"
			class="w-full font-medium text-gray-500 dark:text-gray-200"
		>
			Have you proofread everything?
		</label>
		<input
			type="checkbox"
			id="checked"
			name="checked"
			required
			class="order-first h-4 w-4 rounded-sm border-gray-300 text-international-orange-500 focus:ring-international-orange-400"
		/>
	</div>

	<!-- Honeypot: hidden from people and assistive tech, bots fill it in -->
	<div aria-hidden="true" class="absolute -left-[9999px] h-0 w-0 overflow-hidden">
		<label for="nickname">Leave this field empty</label>
		<input type="text" id="nickname" name="nickname" tabindex="-1" autocomplete="off" />
	</div>

	<div class="p-4">
		<div
			class="cf-turnstile"
			data-sitekey={siteKey}
			data-theme="auto"
			data-response-field-name="cf-turnstile-response"
		>
		</div>
	</div>

	<div class="grid grid-flow-col items-center justify-start py-5">
		<button
			type="submit"
			id="contact-submit"
			class="inline-flex w-full cursor-pointer justify-center rounded-sm border border-transparent bg-gray-100 px-4 py-2 font-medium text-base text-gray-900 shadow-xs hover:bg-green-500 hover:text-white focus:bg-green-400 focus:text-white focus:outline-hidden focus:ring-2 focus:ring-green-500 focus:ring-offset-2 disabled:opacity-60 sm:ml-3 sm:w-auto"
		>
			Send now
		</button>
	</div>
	<p id="contact-error" role="alert" class="hidden px-4 text-red-600 text-sm"></p>
</form>

<dialog
	id="contact-done"
	class="m-auto w-full max-w-md rounded-sm bg-white p-6 text-left shadow-xl backdrop:bg-black/50 dark:border-2 dark:border-zinc-50 dark:bg-zinc-950"
>
	<h3 class="font-medium text-gray-900 text-lg leading-6 dark:text-gray-100">
		Your message has been sent!
	</h3>
	<p class="mt-2 text-gray-500 dark:text-gray-200">I'll be in touch soon</p>
	<form method="dialog" class="mt-4">
		<button
			class="inline-flex justify-center rounded-sm border border-transparent bg-zinc-100 px-4 py-2 font-medium text-blue-900 hover:bg-zinc-200"
		>
			Got it!
		</button>
	</form>
</dialog>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
></script>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const submit = document.getElementById('contact-submit') as HTMLButtonElement;
	const errorEl = document.getElementById('contact-error') as HTMLElement;
	const done = document.getElementById('contact-done') as HTMLDialogElement;
	const opened = Date.now();

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		errorEl.classList.add('hidden');
		const fd = new FormData(form);
		const body: Record<string, unknown> = { _type: form.dataset.type, ts: opened };
		for (const [k, v] of fd.entries()) body[k] = v;
		body.checked = fd.get('checked') === 'on';
		submit.disabled = true;
		try {
			const res = await fetch('/api/send', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(body),
			});
			if (!res.ok) {
				const data = (await res.json().catch(() => ({}))) as { error?: string };
				throw new Error(data.error || 'Something went wrong. Please try again');
			}
			form.reset();
			done.showModal();
		} catch (err) {
			errorEl.textContent =
				err instanceof Error ? err.message : 'Something went wrong. Please try again';
			errorEl.classList.remove('hidden');
		} finally {
			submit.disabled = false;
			// Turnstile tokens are single-use
			(window as unknown as { turnstile?: { reset(): void } }).turnstile?.reset();
		}
	});
</script>
