---
import { footerLinks } from '../lib/site';
import Container from './Container.astro';
---

<footer class="mt-32 flex-none">
	<Container>
		<div class="border-zinc-100 border-t pt-10 pb-16 dark:border-zinc-700/40">
			<div class="flex flex-col items-center justify-between gap-6 lg:flex-row">
				<div
					class="flex flex-wrap justify-center gap-x-6 gap-y-1 font-medium text-sm text-zinc-900 dark:text-zinc-200"
				>
					{
						footerLinks.map(({ url, label }) => (
							<a
								href={url}
								class="transition hover:text-international-orange-400 dark:hover:text-international-orange-500"
							>
								{label}
							</a>
						))
					}
				</div>
				<p class="text-sm text-zinc-400 dark:text-zinc-500">
					© 1992—{new Date().getFullYear()} Jp Valery. All rights reserved
				</p>
			</div>
		</div>
	</Container>
</footer>
