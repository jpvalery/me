---
import ExtLink from "./icons/ExtLink.astro";

interface Props {
	title: string;
	metric: string;
	/** Only set for a page specific to this metric */
	href?: string;
}
const { title, metric, href } = Astro.props;
const Wrapper = href ? "a" : "div";
---

<li class="list-none">
	<Wrapper href={href} rel={href ? 'noopener' : undefined} class="group block">
		<span
			class:list={[
				'flex items-center gap-2 text-[0.75rem] text-stone-500 uppercase tracking-[0.14em] dark:text-phosphor-500',
				href &&
					'transition group-hover:text-international-orange-700 dark:group-hover:text-international-orange-500',
			]}
		>
			{title}
			{href && <ExtLink class="size-3" />}
		</span>
		<span
			class="mt-2 block font-departure text-3xl text-international-orange-700 dark:text-international-orange-500 dark:[text-shadow:0_0_14px_rgb(255_122_31/0.5)]"
		>
			{metric}
		</span>
	</Wrapper>
</li>
