---
import ExtLink from './icons/ExtLink.astro';

const { title, metric, href } = Astro.props;
---

<li class="list-none">
	<a href={href} rel="noopener" class="group block">
		<span
			class="flex items-center gap-2 text-[0.68rem] text-stone-500 uppercase tracking-[0.14em] transition group-hover:text-international-orange-600 dark:text-phosphor-500 dark:group-hover:text-international-orange-500"
		>
			{title}
			<ExtLink class="size-3" />
		</span>
		<span
			class="mt-2 block font-departure text-3xl text-international-orange-600 dark:text-international-orange-500 dark:[text-shadow:0_0_14px_rgb(255_122_31/0.5)]"
		>
			{metric}
		</span>
	</a>
</li>
