---
interface Props {
	href?: string;
	variant?: 'primary' | 'secondary';
	class?: string;
	type?: 'button' | 'submit';
	disabled?: boolean;
}
const {
	href,
	variant = 'primary',
	class: className,
	type = 'button',
	disabled,
	...rest
} = Astro.props;
const variants = {
	primary:
		'bg-international-orange-500 font-medium text-ink-950 hover:bg-international-orange-400 active:bg-international-orange-600 dark:shadow-[0_0_14px_rgb(255_122_31/0.35)]',
	secondary:
		'border border-stone-300 bg-transparent font-medium text-zinc-900 hover:border-international-orange-500 hover:text-international-orange-600 dark:border-ink-700 dark:text-phosphor-100 dark:hover:text-international-orange-500',
};
const classes = [
	'inline-flex items-center gap-2 justify-center px-4 py-2.5 text-sm uppercase tracking-wider outline-offset-2 transition active:transition-none disabled:opacity-60',
	variants[variant],
	className,
];
---

{
	href ? (
		<a href={href} class:list={classes} {...rest}>
			<slot />
		</a>
	) : (
		<button type={type} disabled={disabled} class:list={classes} {...rest}>
			<slot />
		</button>
	)
}
