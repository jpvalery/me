---
const { title } = Astro.props;
const id = `s-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section
	aria-labelledby={id}
	class="md:border-zinc-100 md:border-l md:pl-6 md:dark:border-zinc-700/40"
>
	<div class="grid max-w-3xl grid-cols-1 items-baseline gap-y-8 md:grid-cols-4">
		<h2
			id={id}
			class="font-semibold text-sm text-zinc-900 dark:text-zinc-100"
		>
			{title}
		</h2>
		<div class="md:col-span-3"><slot /></div>
	</div>
</section>
