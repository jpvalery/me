---
import { type CollectionEntry, getCollection } from "astro:content";
import LinkCard from "./LinkCard.astro";

interface Props {
	section: CollectionEntry<"cards">["data"]["section"];
	columns?: string;
}
const { section, columns = "md:grid-cols-2" } = Astro.props;
const cards = (
	await getCollection("cards", (c) => c.data.section === section)
).sort((a, b) => a.data.order - b.data.order);
---

<ul class:list={['grid grid-cols-1 items-stretch gap-6 lg:gap-8', columns]}>
	{
		cards.map((card) => card.data.href && (
			<li class="h-full">
				<LinkCard
					title={card.data.title}
					href={card.data.href}
					label={card.data.label}
					description={card.data.description}
					logo={card.data.logo}
					invertLogo={card.data.invertLogoOnDark}
				/>
			</li>
		))
	}
</ul>
