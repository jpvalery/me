---
import { Image } from 'astro:assets';
import avatar from '../images/avatar.jpg';
import photoPizzaBaking from '../images/photos/jp-valery-baking-pizza.jpg';
import photoCamera from '../images/photos/jp-valery-camera.jpg';
import photoPilot1 from '../images/photos/jp-valery-pilot-1.jpg';
import photoPilot2 from '../images/photos/jp-valery-pilot-2.jpg';
import photoPilot4 from '../images/photos/jp-valery-pilot-4.jpg';
import Tile from './Tile.astro';

interface Props {
	set?: 'home' | 'date';
}
const { set = 'home' } = Astro.props;

const sets = {
	home: [
		[photoPilot2, 'Jp in a small plane, headset on'],
		[photoCamera, 'Jp holding a film camera'],
		[photoPilot4, 'Jp on the ground after a flight'],
		[photoPizzaBaking, 'Jp baking a pizza'],
		[photoPilot1, 'Jp by the aircraft before takeoff'],
	],
	date: [
		[photoPilot4, 'Jp on the ground after a flight'],
		[avatar, 'Portrait of Jp'],
		[photoPizzaBaking, 'Jp baking a pizza'],
	],
} as const;
const images = sets[set];
---

<div class="mx-auto max-w-7xl px-4 pb-2 sm:px-8">
	<Tile
		label="Photography"
		aside={set === 'home' ? '300M+ views on Unsplash' : undefined}
	>
		<ul
			class:list={[
				'grid grid-cols-2 gap-4 sm:gap-6',
				images.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-3 lg:grid-cols-5',
			]}
		>
			{
				images.map(([image, alt]) => (
					<li class="group relative aspect-4/5 overflow-hidden bg-international-orange-500 dark:bg-[#1a0e05]">
						<Image
							src={image}
							alt={alt}
							sizes="(min-width: 1024px) 14rem, (min-width: 640px) 30vw, 45vw"
							class="absolute inset-0 size-full object-cover contrast-110 grayscale mix-blend-multiply transition duration-300 group-hover:mix-blend-normal group-hover:grayscale-0 dark:mix-blend-screen dark:group-hover:mix-blend-normal"
						/>
					</li>
				))
			}
		</ul>
		{
			set === 'home' && (
				<a
					href="/photography"
					class="mt-6 inline-block text-xs text-international-orange-600 uppercase tracking-wider hover:underline dark:text-international-orange-500"
				>
					Browse photos →
				</a>
			)
		}
	</Tile>
</div>
