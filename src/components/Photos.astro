---
import { Image } from 'astro:assets';
import avatar from '../images/avatar.jpg';
import photoPizzaBaking from '../images/photos/jp-valery-baking-pizza.jpg';
import photoCamera from '../images/photos/jp-valery-camera.jpg';
import photoPilot1 from '../images/photos/jp-valery-pilot-1.jpg';
import photoPilot2 from '../images/photos/jp-valery-pilot-2.jpg';
import photoPilot4 from '../images/photos/jp-valery-pilot-4.jpg';

interface Props {
	set?: 'home' | 'date';
}
const { set = 'home' } = Astro.props;

const sets = {
	home: [
		[photoPilot2, 'Jp in a small plane, headset on'],
		[photoCamera, 'Jp holding a film camera'],
		[photoPilot4, 'Jp on the ground after a flight'],
		[photoPizzaBaking, 'Jp baking a pizza'],
		[photoPilot1, 'Jp by the aircraft before takeoff'],
	],
	date: [
		[photoPilot4, 'Jp on the ground after a flight'],
		[avatar, 'Portrait of Jp'],
		[photoPizzaBaking, 'Jp baking a pizza'],
	],
} as const;
const images = sets[set];
---

<div class="mt-16 sm:mt-20">
	<div
		class="-my-4 flex flex-col items-center gap-5 py-4 sm:flex-row sm:justify-center sm:gap-8 sm:overflow-hidden"
	>
		{
			images.map(([image, alt]) => (
				<div class="relative aspect-9/10 w-64 flex-none overflow-hidden rounded-sm bg-zinc-100 sm:w-72 dark:bg-zinc-900">
					<Image
						src={image}
						alt={alt}
						sizes="(min-width: 640px) 18rem, 11rem"
						class="absolute inset-0 h-full w-full object-cover"
					/>
				</div>
			))
		}
	</div>
</div>
